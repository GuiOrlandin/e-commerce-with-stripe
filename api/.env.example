DATABASE_URL=postgresql://guilherme:123456@localhost:5433/e-commerce-db?schema=public
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRE=1d

STRIPE_SECRET_KEY=

# Optional: used by `npm run db:create-admin`
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=admin123456
ADMIN_NAME=Admin

OLLAMA_BASE_URL=http://localhost:11434
# Chat v1 works with qwen2.5:7b. Chat v2 agent tool-calling works better with
# qwen2.5 / llama3.1 (see docs/adr/chat-langchain-v1.md). Fallback search still runs.
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=60000
EMBEDDING_SERVICE_URL=http://localhost:8000
CHAT_SIMILARITY_THRESHOLD=0.65
CHAT_TOP_K=5
CHAT_RETRIEVE_K=15
CHAT_RERANK_N=10
CHAT_RRF_K=60
CHAT_RERANK_ENABLED=true
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_MS=60000
CHAT_TOKEN_DAILY_LIMIT=50000
CHAT_TOKEN_OVERHEAD=1500
CHAT_AGENT_RECURSION_LIMIT=6
CHAT_HISTORY_MAX_MESSAGES=12
